class Solution {
    public int[] solution(String s) {
        int[] answer = {};
        int count = 0, remove = 0;
        while(!s.equals("1")) {
            count++;
            int n = s.length();
            int c = 0;
            for(int i=0; i<n; i++) {
                if(s.charAt(i) == '1')    c++;
            }
            remove += (n-c);
            s = toBinary(c);
        }
        return new int[] {count, remove};
    }
    
    public static String toBinary(int num) {
        if(num == 1) return "1";
        return toBinary(num/2) + Integer.toString(num % 2);
    }
}