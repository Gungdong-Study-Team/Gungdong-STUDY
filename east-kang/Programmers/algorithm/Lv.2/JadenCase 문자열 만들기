import java.util.*;
class Solution {
    public String solution(String s) {
        String answer = "";
        s = s.toLowerCase();
        
        for(int i=0; i<s.length(); i++) {
            char c = s.charAt(i);
            if((i==0) || (i>0 && s.charAt(i-1) == ' ')) {
                c = Character.toUpperCase(c);
            }
            answer += c;
        }
        return answer;
    }
}