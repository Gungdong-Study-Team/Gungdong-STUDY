class Solution {
    public int solution(int n) {
        int answer = 0, cnt = countOne(Integer.toBinaryString(n));
        
        for(int i=n+1; i<=1000000; i++) {
            if(cnt == countOne(Integer.toBinaryString(i)))
                return i;
        }
        return 0;
    }
    
    public static int countOne(String s) {
        int cnt = 0;
        for(int i=0; i<s.length(); i++) { if(s.charAt(i)=='1') cnt++; }
        return cnt;
    }
}