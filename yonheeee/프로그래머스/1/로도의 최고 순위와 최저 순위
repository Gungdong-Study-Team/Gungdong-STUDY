## AI 코드
```
class Solution {
    public int[] solution(int[] lottos, int[] win_nums) {
        int zero = 0;
        int match = 0;

        for (int lotto : lottos) {
            if (lotto == 0) {
                zero++;
                continue;
            }

            for (int win : win_nums) {
                if (lotto == win) {
                    match++;
                    break;
                }
            }
        }

        int max = match + zero;
        int min = match;

        return new int[]{rank(max), rank(min)};
    }

    private int rank(int count) {
        return count < 2 ? 6 : 7 - count;
    }
}
```