## 풀이방법
로또의 번호가 지워져서 몇몇의 숫자가 안보임</br>
그래서 안보이는 숫자가 다 맞는다고 가정하는 최고순위와 다 틀린다고 가정하는 최저순위를 구하는 문제</br>
그냥 문제 이해하고 구현</br>

## 코드
```
//lottos : 구매한 로또 번호, win_num : 당첨 번호 배열
// answer[많이 맞혔을 때 등수, 틀렸을때 등수]
// 
class Solution {
    public int[] solution(int[] lottos, int[] win_nums) {
        int[] answer = new int[2];
        
        int matchcnt = 0; 
        int zerocnt = 0;
        
        //맞는다는 가정
        for(int num : lottos){
            if(num == 0){
                zerocnt++;
            }
        }
        
        //진짜 맞았을 경우
        for(int num : win_nums){
            for(int i = 0; i < lottos.length; i++){
                if(lottos[i] == num){
                    matchcnt++;
                }
            }
        }
        
        int wincnt = matchcnt + zerocnt;
        int losecnt = matchcnt;
        System.out.println(wincnt + " " + losecnt);
        
        if(wincnt == 0){
            wincnt = 6;
        }else{
            wincnt=7 - wincnt;
        }
               
        if(losecnt == 0){
            losecnt = 6;
        }else{ 
            losecnt=7 - losecnt;
        }

        for(int i = 0; i < answer.length; i++){
            if(i==0)answer[i] = wincnt;
            if(i==1) answer[1] = losecnt;
        }
        return answer;
    }
}
```

